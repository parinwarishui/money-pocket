rules_version = '2';

// Each signed-in user can only ever read or write their own
// users/{uid} document and everything nested under it (settings,
// transactions, categories). No one — not even another signed-in
// user — can touch a uid that isn't their own.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
